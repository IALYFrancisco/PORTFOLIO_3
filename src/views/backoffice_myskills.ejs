<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        @font-face {
            font-family: proxima_soft_thin;
            src: url("../assets/font/ProximaSoft-Thin.ttf");
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, follow">
    <link rel="shortcut icon" href="../assets/images/logo-de-IALY-Francisco-Raymond.png" type="image/x-icon">
    <link rel="stylesheet" href="../assets/css/backoffice.css">
    <title>Backoffice Skills | PORTFOLIO</title>
</head>
<body>
    <main id="container">
        <%- include('../partials/backoffice/BO_sidebar') -%>
        <main id="right">
            <%- include('../partials/backoffice/header') %>
            <div id="container_BO_my_skills">
                <div class="action">
                    <h1 class="title">My skills</h1>
                    <button>Add skill</button>
                </div>
                <div class="list_of_my_skills">
                    <% data.forEach(element => { %>
                        <ul>
                            <li> <img src="../<%- element.skill_image_logo_file_url %>" alt=""></li>
                            <li style="text-transform: uppercase;"> <%- element.skill_name %> </li>
                            <li> <%- element.knowledge_level %> </li>
                            <% if( element.known_library == "" ){ %>    
                            <li> <%- "-----" %> </li>
                            <% }else{ %>
                            <li style="display: flex; text-wrap: wrap;"> <%- element.known_library %> </li>
                            <% } %>
                            <li class="item_action" style="display: flex; justify-content: flex-end; align-items: center;">
                                Delete  ||  Edit  ||  <span style="display: flex; align-items: center;"> <img style="width: 20px;" src="assets/icon/icons8-info-pastel/icons8-info-100.png" alt=""> </span>
                            </li>
                        </ul>
                        <% }); %>
                </div>
            </div>
        </main>
    </main>
</body>
</html>