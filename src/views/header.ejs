<header>
    <div class="none">
    </div>
    <nav>
        <ul>
            <li>
                <a href="/">Who am I?</a>
            </li>
            <li>
                <a href="my-skills">My Skills</a>
            </li>
            <li>
                <a href="my-projects">My Projects</a>
            </li>
            <li>
                <a href="my-contacts">My Contacts</a>
            </li>
        </ul>
    </nav>
    <% if(user){ %>
        <div class="button-container">
            <% if(user.role === "admin"){ %>
                <a href="/backoffice">
                    <button>Dashboard</button>
                </a>
            <% } %>
            <div class="border">
                <div class="profile">
                    <img src="<%- user.profile %>" alt="Default profile.">
                </div>
                <div class="dropdown-container">
                    <div class="dropdown">
                        <div class="user-info">
                            <div class="profile-container">
                                <img src="<%- user.profile %>" alt="User name">
                            </div>
                            <div class="name">
                                <h4><%- user.name %></h4>
                                <h5><%- user.email %></h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="button-container">
            <a href="/authentication/login">
                <button>Login</button>
            </a>
        </div>
    <% } %>
    <div class="menu">
        <img src="assets/icon/icons8-menu-color/icons8-menu-480.png" alt="" id="toggleBtn">
    </div>
</header>
<div class="nav" id="navResponsive">
    <ul>
        <li>
            <a href="/">Who am I?</a>
        </li>
        <li>
            <a href="my-skills">My Skills</a>
        </li>
        <li>
            <a href="my-projects">My Projects</a>
        </li>
        <li>
            <a href="my-contacts">My Contacts</a>
        </li>
        <% if(user){ %>
            <li>
                <% if(user.role === "admin"){ %>
                    <a href="/backoffice">
                        <button>Dashboard</button>
                    </a>
                <% } %>
            </li>
        <% } else { %>
            <li>
                <a href="/authentication/login">
                    <button>Login</button>
                </a>
            </li>
        <% } %>
    </ul>
</div>