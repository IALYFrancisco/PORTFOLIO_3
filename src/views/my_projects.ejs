<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        @font-face {
            font-family: proxima_soft_thin;
            src: url("assets/font/ProximaSoft-Thin.ttf");
        }
    </style>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="assets/css/my-projects.css">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Projects | PORTFOLIO</title>
</head>
<body>
    <main class="container">
        <%- include("header") %>
        <section class="my-projects"></section>
        <div class="left my_projects">
            <p class="title">
                My Projects
            </p>
            <p class="incitation">
                Scroll now to see others projects 😀
            </p>
            <div class="list_project">

                <% documents.forEach( item => { %>
                
                    <div class="project">
                        
                        <video src="<%- item.movie_file_url -%>" autoplay loop controls></video>

                        <div class="project_action">
                        
                            <span class="project_name"><%- item.name -%></span>

                            <div class="images_link">

                                <a href="" title="More info about the project">

                                    <img src="assets/icon/icons8-info-color/icons8-info-100.png" alt="">

                                </a>

                            </div>

                            <a href="<%- item.host_url -%>" target="_blank">
                                <button class="live_demo">Watch live</button>
                            </a>

                        </div>
                    
                    </div>
                    
                <% }); %>

            </div>
            <button id="seeMoreProjectBtn">See more</button>
        </div>
        <div class="right img">
            <img src="assets/images/DSC_3033.JPG" alt="IALY Francisco Raymond à la certification de TME." title="IALY Francisco Raymond à la certification de TME.">
        </div>
    </main>
</body>
<script src="assets/js/myprojects.js"></script>
</html>