<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="assets/css/my-projects.css">
    <link rel="shortcut icon" href="assets/images/logo-de-IALY-Francisco-Raymond.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Projects | PORTFOLIO</title>
</head>
<body>
    <main class="container">
        <%- include("header") %>
        <section class="my-projects">
            <div class="left">
                <h1>My Projects</h1>
                <p class="incitation">
                    Scroll now to see others projects 😀
                </p>
                <div class="list_project">

                <% if(projects){ %>
                
                    <% projects.forEach( project => { %>
                    
                        <div class="project">
                            
                            <video src="<%- project.movie_file_url -%>" autoplay loop controls></video>

                            <div class="project_action">
                                <h4><%- project.name -%></h4>
                                <p class="type">
                                    Type: <span><%- project.type -%></span>
                                </p>
                                <p class="skills">
                                    Skills: <span><%- project.skills -%></span>
                                </p>
                                <a href="<%- project.host_url -%>" target="_blank">
                                    <button class="live_demo">Watch live</button>
                                </a>

                            </div>
                        
                        </div>
                        
                    <% }); %>

                <% } %>

                </div>
                <button id="seeMoreProjectBtn">See more</button>
            </div>
            <div class="right">
                <img src="assets/images/IALY-Francisco-Raymond-à-la-certification-TME.jpg" alt="IALY Francisco Raymond à la certification de TME." title="IALY Francisco Raymond à la certification de TME.">
            </div>
        </section>
    </main>
    <%- include('footer') %>
</body>
<script src="assets/js/myprojects.js"></script>
</html>