<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        @font-face {
            font-family: proxima_soft_thin;
            src: url("assets/font/ProximaSoft-Thin.ttf");
        }
    </style>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="assets/css/my-contacts.css">
    <link rel="shortcut icon" href="assets/images/logo-de-IALY-Francisco-Raymond.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Contacts | PORTFOLIO</title>
</head>
<body>
    <script>
        document.getElementById('toggleBtn').addEventListener('click', (event) => {
            document.getElementById('navResponsive').classList.toggle('active');
        })
    </script> 
    <main class="container">
        <%- include("header") %>
        <div class="my_container">
            <p class="title">
                My Contacts
            </p>
            <div class="list_contact">
                <a href="https://www.linkedin.com/in/francisco-raymond-ialy-41ab21300/" target="_blank">
                    <div class="contact">
                        <img src="assets/images/linkedin.png" alt="">
                        <label for="contact">Francisco RAYMOND IALY</label>
                    </div>
                </a>
                <a href="mailto:ialyfrancisco7@gmail.com">
                    <div class="contact">
                        <img src="assets/images/gmail.png" alt="">
                        <label for="contact">ialyfrancisco7@gmail.com</label>
                    </div>
                </a>
                <a href="https://github.com/IALYFrancisco" target="_blank">
                    <div class="contact">
                        <img src="assets/images/github.png" alt="">
                        <label for="contact">Francisco IALY</label>
                    </div>
                </a>
                <a href="#">
                    <div class="contact">
                        <img src="assets/images/phone.png" alt="">
                        <label for="contact">+261 34 47 635 78</label>
                    </div>
                </a>
                <a href="https://www.facebook.com/fifi.fy.75/" target="_blank">
                    <div class="contact">
                        <img src="assets/images/facebook.png" alt="">
                        <label for="contact">Buffalo Buffalo</label>
                    </div>
                </a>
                <a href="assets/documents/CV de IALY Francisco Raymond.pdf" target="_blank" alt="CV de IALY Francisco Raymond">
                    <div class="contact">
                        <img src="assets/images/cv.png" alt="">
                        <label for="contact">Mon CV</label>
                    </div>
                </a>
            </div>
        </div>
    </main>
</body>
<script src="assets/js/mycontacts.js"></script>
</html>